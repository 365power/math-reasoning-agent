# ===== 解题模型（当前基线：ModelScope Qwen3.5-35B-A3B） =====
# 变量名沿用 DEEPSEEK_*，因为客户端是 OpenAI 兼容接口，不绑定服务商。
# 把下面的 sk-REPLACE_ME 换成你自己的密钥；不要提交到仓库。
DEEPSEEK_API_KEY=sk-REPLACE_ME
DEEPSEEK_BASE_URL=https://api-inference.modelscope.cn/v1
DEEPSEEK_MODEL=Qwen/Qwen3.5-35B-A3B

# 如果改用 DeepSeek 作为解题模型：
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# ===== 评分模型（留空则复用上面的解题模型） =====
# 当前基线：deepseek-flash；后续阶段按需求切换为
# gpt-oss-120 或 gemini-3.5-flash-thinking。
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=

# ===== 生成参数 =====
TEMPERATURE=1.0
TOP_P=0.95
MAX_TOKENS=16384
ROLLOUTS=8
MAX_TOOL_ROUNDS=12
TOOL_TIMEOUT=30
